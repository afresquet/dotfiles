@@ -21,6 +21,24 @@ using WindowAddress = std::string;
 
 namespace waybar::modules::hyprland {
 
+// Hyprland 0.56 replaced the numeric `id` field in workspace IPC replies
+// with a string `address`. Keep an internal integer identity so Waybar's
+// existing workspace state machinery works with either IPC schema.
+inline int workspaceId(std::string const& address) {
+  try {
+    return address == "special" ? -99 : std::stoi(address);
+  } catch (std::exception const&) {
+    uint32_t hash = 2166136261u;  // FNV-1a: deterministic for IPC events.
+    for (unsigned char c : address) hash = (hash ^ c) * 16777619u;
+    return -static_cast<int>((hash % 2147483546u) + 1u);
+  }
+}
+
+inline int workspaceId(Json::Value const& workspace) {
+  return workspace["id"].isInt() ? workspace["id"].asInt()
+                                 : workspaceId(workspace["address"].asString());
+}
+
 class Workspaces;
 class Workspace {
  public:
