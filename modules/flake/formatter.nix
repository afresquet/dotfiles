# `nix fmt` and the formatting check in `nix flake check`.
{ inputs, ... }:
{
  imports = [ inputs.treefmt-nix.flakeModule ];

  perSystem.treefmt = {
    projectRootFile = "flake.nix";
    programs = {
      nixfmt.enable = true;
      statix = {
        enable = true;
        # Options are grouped by concern with a comment each, like
        # nixpkgs' own modules, rather than by top-level key.
        disabled-lints = [ "repeated_keys" ];
      };
      deadnix.enable = true;
      # Standalone scripts (.github/scripts); scripts written in Nix go through
      # writeShellApplication, which runs shellcheck when they build.
      shellcheck.enable = true;
      shfmt = {
        enable = true;
        indent_size = 2;
      };
      actionlint.enable = true;
    };
    # Indent case branches, as the scripts already do.
    settings.formatter.shfmt.options = [ "-ci" ];
    # Generated by nixos-generate-config; keep them diffable against a
    # fresh run rather than reformatted.
    settings.global.excludes = [ "modules/hosts/*/hardware-configuration.nix" ];
  };
}
